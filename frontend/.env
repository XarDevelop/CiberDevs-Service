# URL base de la API
# En desarrollo: Vite proxy redirige /api al backend (configurado en vite.config.ts)
# En producción (Vercel): el serverless function maneja /api en el mismo origen
# Para backend externo: https://tu-backend.com
VITE_API_URL=/api

# URL del backend para el proxy de desarrollo (vite.config.ts)
VITE_DEV_API_URL=http://localhost:3000
