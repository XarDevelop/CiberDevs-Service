# ─── Servidor ───────────────────────────────────────────
PORT=3000
NODE_ENV=development          # Cambiar a 'production' en producción

# ─── Base de Datos (Neon.sh PostgreSQL) ─────────────────
# Opción A: URL completa (recomendada para Neon.sh)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Opción B: Variables individuales
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=supersecretpassword
DB_NAME=ciberdevs_db
DB_SSL=false                   # true para Neon.sh / producción
DB_POOL_MAX=20

# ─── Autenticación ──────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_random_secret_key
JWT_EXPIRES_IN=1h

# Generar hash con: node -e "const bcrypt=require('bcrypt'); bcrypt.hash('tu_contraseña',10).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── CORS ───────────────────────────────────────────────
# Dominio del frontend en producción, separar múltiples con coma
CORS_ORIGIN=http://localhost:5173
